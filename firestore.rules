rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- User Profiles ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId && 
               data.email is string && data.email.size() <= 128 &&
               (!('farmName' in data) || (data.farmName is string && data.farmName.size() <= 100)) &&
               (!('landSize' in data) || (data.landSize is string && data.landSize.size() <= 50)) &&
               (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['farmName', 'landSize', 'tags', 'updatedAt']);
    }

    // --- Grains Marketplace ---
    match /grains/{grainId} {
      function isValidGrain(data) {
        return data.userId is string &&
               data.type is string && data.type.size() <= 50 &&
               data.variety is string && data.variety.size() <= 100 &&
               data.grade is string && data.grade.size() <= 10 &&
               data.price is number && data.price >= 0 &&
               data.quantity is string && data.quantity.size() <= 50;
      }

      function isPlaceBidAction() {
        return incoming().diff(existing()).affectedKeys().hasOnly(['highestBid', 'highestBidderName', 'highestBidderId']) &&
               incoming().highestBidderId == request.auth.uid &&
               incoming().highestBid > (existing().get('highestBid', existing().price));
      }

      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidId(grainId) && isValidGrain(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isVerified() && (
        (isOwner(existing().userId) && isValidGrain(incoming()) && incoming().userId == existing().userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['price', 'quantity', 'status', 'updatedAt', 'farmerName', 'variety', 'type', 'grade', 'image'])) ||
        isPlaceBidAction()
      );
      allow delete: if isVerified() && isOwner(existing().userId);

      // --- Bids Subcollection ---
      match /bids/{bidId} {
        function isValidBid(data) {
          return data.userId == request.auth.uid &&
                 data.amount is number && data.amount > 0 &&
                 data.userName is string;
        }
        allow list: if isSignedIn();
        allow create: if isVerified() && isValidBid(incoming()) && 
                        incoming().amount > (get(/databases/$(database)/documents/grains/$(grainId)).data.get('highestBid', get(/databases/$(database)/documents/grains/$(grainId)).data.price));
      }
    }

    // --- Messages ---
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.senderId == request.auth.uid &&
               data.receiverId is string &&
               data.text is string && data.text.size() <= 1000;
      }
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isVerified() && isValidMessage(incoming());
      allow update: if isVerified() && resource.data.receiverId == request.auth.uid && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    // --- Soil Health Records ---
    match /soil_records/{recordId} {
      function isValidSoil(data) {
        return data.userId == request.auth.uid &&
               data.ph is number &&
               data.nitrogen is string &&
               data.phosphorus is string &&
               data.potassium is string &&
               data.moisture is string &&
               data.date is string;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(recordId) && isValidSoil(incoming());
      allow update: if isVerified() && isOwner(existing().userId) && isValidSoil(incoming());
      allow delete: if isVerified() && isOwner(existing().userId);
    }
  }
}
